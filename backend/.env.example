# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ertmac_nwis

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Storage
CHROMA_PATH=./chroma_data
DOCUMENT_STORAGE_PATH=./document_storage
RAW_DATA_PATH=../data/raw

# LLM provider: Groq (OpenAI-compatible API). Optional — if unset, the RAG
# pipeline still does real hybrid retrieval but falls back to deterministic
# (non-LLM) answer synthesis from the top evidence.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Retrieval models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
